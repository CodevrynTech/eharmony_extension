# Get a key at https://aistudio.google.com/apikey (use a paid-tier key for private data)
GEMINI_API_KEY=

# One entry per user: label:token[:dailyLimit], comma-separated. Create one with:  pnpm license <label> [dailyLimit]
LICENSES=
# (Local development shortcut) a single token instead of LICENSES. Any random 16+ char string.
API_TOKEN=

PORT=3000
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_DAILY_QUOTA=50
# Optional: only these extension ids may call the API (comma-separated)
ALLOWED_EXTENSION_IDS=
